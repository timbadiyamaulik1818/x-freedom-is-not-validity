library(mocklib) {
  technology (cmos);
  delay_model : table_lookup;
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  capacitive_load_unit (1, pf);
  default_inout_pin_cap : 0.005;
  default_input_pin_cap : 0.005;
  default_output_pin_cap : 0.0;
  default_fanout_load : 1.0;

  cell(INVX1) { area : 1;
    pin(A) { direction : input; capacitance : 0.005; }
    pin(Y) { direction : output; function : "A'"; } }

  cell(BUFX1) { area : 2;
    pin(A) { direction : input; capacitance : 0.005; }
    pin(Y) { direction : output; function : "A"; } }

  cell(NAND2X1) { area : 2;
    pin(A) { direction : input; capacitance : 0.005; }
    pin(B) { direction : input; capacitance : 0.005; }
    pin(Y) { direction : output; function : "(A*B)'"; } }

  cell(NOR2X1) { area : 2;
    pin(A) { direction : input; capacitance : 0.005; }
    pin(B) { direction : input; capacitance : 0.005; }
    pin(Y) { direction : output; function : "(A+B)'"; } }

  cell(AND2X1) { area : 3;
    pin(A) { direction : input; capacitance : 0.005; }
    pin(B) { direction : input; capacitance : 0.005; }
    pin(Y) { direction : output; function : "(A*B)"; } }

  cell(OR2X1) { area : 3;
    pin(A) { direction : input; capacitance : 0.005; }
    pin(B) { direction : input; capacitance : 0.005; }
    pin(Y) { direction : output; function : "(A+B)"; } }

  cell(XOR2X1) { area : 4;
    pin(A) { direction : input; capacitance : 0.005; }
    pin(B) { direction : input; capacitance : 0.005; }
    pin(Y) { direction : output; function : "(A^B)"; } }

  cell(XNOR2X1) { area : 4;
    pin(A) { direction : input; capacitance : 0.005; }
    pin(B) { direction : input; capacitance : 0.005; }
    pin(Y) { direction : output; function : "(A^B)'"; } }

  cell(MUX2X1) { area : 4;
    pin(A) { direction : input; capacitance : 0.005; }
    pin(B) { direction : input; capacitance : 0.005; }
    pin(S) { direction : input; capacitance : 0.005; }
    pin(Y) { direction : output; function : "(A * S') + (B * S)"; } }

  cell(AOI21X1) { area : 3;
    pin(A) { direction : input; capacitance : 0.005; }
    pin(B) { direction : input; capacitance : 0.005; }
    pin(C) { direction : input; capacitance : 0.005; }
    pin(Y) { direction : output; function : "((A*B)+C)'"; } }

  cell(OAI21X1) { area : 3;
    pin(A) { direction : input; capacitance : 0.005; }
    pin(B) { direction : input; capacitance : 0.005; }
    pin(C) { direction : input; capacitance : 0.005; }
    pin(Y) { direction : output; function : "((A+B)*C)'"; } }

  // ---- non-resettable flop : the X-corruption source --------------------
  cell(DFFX1) { area : 6;
    ff(IQ, IQN) { clocked_on : "CK"; next_state : "D"; }
    pin(CK) { direction : input; clock : true; capacitance : 0.008; }
    pin(D)  { direction : input; capacitance : 0.006; }
    pin(Q)  { direction : output; function : "IQ"; } }

  // ---- async active-low reset flop --------------------------------------
  cell(DFFRX1) { area : 8;
    ff(IQ, IQN) { clocked_on : "CK"; next_state : "D"; clear : "RN'"; }
    pin(CK) { direction : input; clock : true; capacitance : 0.008; }
    pin(D)  { direction : input; capacitance : 0.006; }
    pin(RN) { direction : input; capacitance : 0.006; }
    pin(Q)  { direction : output; function : "IQ"; } }
}
